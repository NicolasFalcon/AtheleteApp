# Plantilla del build Release (copiar a .env.production, que está en .gitignore).
# react-native-dotenv lo aplica por encima de .env cuando se empaqueta en producción.
APP_ENV=production
SUPABASE_URL=https://your-production-project.supabase.co
SUPABASE_ANON_KEY=your-production-anon-key
SUPABASE_PASSWORD_RESET_URL=athelete://reset-password
