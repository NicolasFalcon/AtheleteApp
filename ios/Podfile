# Expo modules autolinking (expo-location, expo-task-manager).
require File.join(File.dirname(`node --print "require.resolve('expo/package.json')"`), "scripts/autolinking")

# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# expo-modules-core / expo-location / expo-task-manager need iOS 16.4.
APP_MIN_IOS = '16.4'
platform :ios, APP_MIN_IOS
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'Athelete' do
  use_expo_modules!

  # Expo's autolinking command also lists the non-Expo native modules, so
  # nothing is linked twice.
  config_command = [
    'node',
    '--no-warnings',
    '--eval',
    'require(\'expo/bin/autolinking\')',
    'expo-modules-autolinking',
    'react-native-config',
    '--json',
    '--platform',
    'ios'
  ]
  config = use_native_modules!(config_command)

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # MapLibre Native (iOS) is pulled in as a Swift package: this adds it to
    # the Pods and app targets (maplibre-react-native v11 setup).
    $MLRN.post_install(installer)

    # Xcode 27 rejects deployment targets below 15.0 (some pod resource
    # bundles still declare 9.0–13.0). Raise only those to the app minimum.
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |build_config|
        current = build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
        if current && Gem::Version.new(current) < Gem::Version.new(APP_MIN_IOS)
          build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = APP_MIN_IOS
        end
      end
    end
  end
end
